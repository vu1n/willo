// Willo Layout: Tabs Dev
// Best for: tablet, pc
// Description: Multi-tab development setup with code, git, and server tabs
// Icon: rectangle.stack

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
        children
    }

    tab name="code" focus=true {
        pane split_direction="vertical" {
            pane size="70%" name="editor"
            pane size="30%" name="terminal"
        }
    }

    tab name="git" {
        pane name="git"
    }

    tab name="server" {
        pane stacked=true {
            pane name="logs"
            pane name="processes"
        }
    }
}
